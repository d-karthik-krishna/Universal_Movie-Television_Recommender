# =============================================================================
# CineSphere Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.
# =============================================================================

# TMDB API Credentials (get from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://cinesphere:cinesphere@localhost:5432/cinesphere

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
AUTH_SECRET=change-me-to-a-random-secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
